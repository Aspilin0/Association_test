# LLM（deepseek / ollama / mock）
# 未设置 LLM_API_KEY 时，deepseek 会自动回退到 mock（离线）
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-201b6c5fc1b6410aaa6d317e50a9fe27

LLM_MODEL=deepseek-chat

# Embedding（char_ngram 离线默认 / api）
EMBEDDING_PROVIDER=char_ngram
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# 评分权重（可选，默认已内置）
# SCORE_W_RT=0.40
# SCORE_W_EMOTION=0.25
# SCORE_W_SIMILARITY=0.15
# SCORE_W_CONNECTIVITY=0.20

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
